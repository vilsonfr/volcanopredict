# VolcanoPredict — configuração de desenvolvimento
#
# Copie para .env: cp .env.example .env
# O .env é ignorado pelo Git. Nunca coloque segredo real neste arquivo de exemplo.

# --- Banco de dados ---------------------------------------------------------

# Credenciais do PostgreSQL/PostGIS criado pelo docker compose.
# Valores de desenvolvimento; troque em qualquer ambiente que não seja a sua máquina.
POSTGRES_DB=volcanopredict
POSTGRES_USER=volcano
POSTGRES_PASSWORD=volcano

# String de conexão usada pelo backend. O host "db" é o nome do serviço no compose.
# Obrigatória: o backend encerra na subida se ela não estiver definida.
DATABASE_URL=postgres://volcano:volcano@db:5432/volcanopredict?sslmode=disable

# Tempo máximo que o backend espera o banco aceitar conexões antes de desistir.
# Aceita duração no formato do Go (ex.: 30s, 2m).
DB_CONNECT_TIMEOUT=30s

# --- Servidor HTTP ----------------------------------------------------------

# Endereço de escuta do backend. Vazio equivale a :8080.
HTTP_ADDR=:8080

# Nível mínimo de log: debug, info, warn, error.
LOG_LEVEL=info

# --- Ingestão ---------------------------------------------------------------

# Com que frequência o backend coleta das fontes habilitadas.
# 0 desliga a coleta automática — configuração suportada, para quem prefere
# disparar a ingestão de fora.
INGEST_INTERVAL=15m

# Quanto de histórico o PRIMEIRO ciclo cobre, quando ainda não houve nenhuma
# coleta bem-sucedida. Curto de propósito: carga histórica grande é decisão
# do subcomando `ingest -backfill`, não efeito colateral de subir o serviço.
INGEST_FIRST_RUN_WINDOW=24h

# --- Frontend ---------------------------------------------------------------

# URL do backend usada pelo navegador (fora da rede do compose, por isso localhost).
# Se você mudar BACKEND_HOST_PORT abaixo, ajuste a porta aqui também.
VITE_API_BASE_URL=http://localhost:8080

# --- Globo 3D -----------------------------------------------------------------

# Opcional. Sem token o globo mostra imagem de satelite real (Esri World
# Imagery), mas a superficie e uma esfera lisa: vulcoes ficam planos.
# Com um token gratuito do Cesium Ion (https://ion.cesium.com/tokens) o
# Cesium World Terrain e ativado e o relevo real aparece.
VITE_CESIUM_ION_TOKEN=

# --- Portas publicadas no host ----------------------------------------------
#
# Só afetam o mapeamento para fora do compose. As portas internas dos containers
# nunca mudam, então DATABASE_URL continua apontando para db:5432.
# Altere apenas se a porta já estiver ocupada na sua máquina — é comum ter uma
# instalação local de PostgreSQL segurando a 5432.
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
